APP_NAME=p2bsr.live
BASE_URL=http://127.0.0.1:8000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Comma-separated Discord user IDs with owner access. A single ID works too.
OWNER_DISCORD_ID=

# Notify a Discord channel when runs need review. Leave blank to disable
DISCORD_MODERATION_WEBHOOK_URL=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

DATABASE_URL=sqlite:///./data/portal2_runs.db
COOKIE_SECURE=false

# Leave both blank to disable Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# These 2 don't matter if you aren't using Docker
APP_PORT=8000
DATA_PATH=/opt/portal2-beta-leaderboard/data
